// CUBE 6 online server: Cloudflare Workers + Durable Objects + D1.
// Local: `npm run db:local` once, then `npm run dev` (http://localhost:8787).
// Secrets (IP_SALT, LIMITS, PAUSED) are never written here: `.dev.vars` locally,
// `wrangler secret put` in production.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cube6-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  // no usage statistics from this machine to Cloudflare
  "send_metrics": false,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      // one for all players: random matching and 合言葉
      { "name": "LOBBY", "class_name": "Lobby" },
      // one per game room
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Lobby", "GameRoom"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cube6",
      // replaced by the real id when the database is created on Cloudflare
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // pages allowed to use the server: the game's address, and the local development pages
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,https://haruki-11s.github.io"
  }
}
